# --- Public site configuration (build time) ---
# Canonical production URL, no trailing slash. Used for canonical links, sitemap, Open Graph.
VITE_SITE_URL=https://kaayraherbals.example

# Contact details. Leave blank until real, verified details exist; the site hides empty fields.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
VITE_LEGAL_ENTITY_NAME=
VITE_INSTAGRAM_URL=https://www.instagram.com/kaayraherbals_official/

# --- Launch notification backend (server only, set in Vercel project settings) ---
# Supabase project URL and SERVICE ROLE key. Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: comma-separated allowed origins for the signup endpoint (defaults to same-origin).
ALLOWED_ORIGINS=
